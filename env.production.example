# 🔧 Пример файла переменных окружения для продакшена
# Скопируйте этот файл в .env и настройте под свои нужды

# ===========================================
# ОСНОВНЫЕ НАСТРОЙКИ ПРИЛОЖЕНИЯ
# ===========================================

# Режим работы приложения (production, development, testing)
APP_ENV=production

# Порт и хост для прослушивания
APP_PORT=8080
APP_HOST=0.0.0.0

# URL бэкенда (внешний адрес)
BACKEND_URL=http://194.87.143.169:8080

# Версия API
API_VERSION=v1

# ===========================================
# НАСТРОЙКИ БАЗЫ ДАННЫХ POSTGRESQL
# ===========================================

# Хост базы данных
DB_HOST=localhost

# Порт базы данных
DB_PORT=5432

# Имя базы данных
DB_NAME=axenta_db

# Пользователь базы данных
DB_USER=axenta_user

# Пароль базы данных (ОБЯЗАТЕЛЬНО ИЗМЕНИТЕ!)
DB_PASSWORD=your_secure_database_password_here

# Режим SSL для подключения к БД (require, disable, prefer)
DB_SSLMODE=require

# Максимальное количество открытых соединений
DB_MAX_OPEN_CONNS=25

# Максимальное количество простаивающих соединений
DB_MAX_IDLE_CONNS=5

# Время жизни соединения
DB_CONN_MAX_LIFETIME=300s

# ===========================================
# JWT И АУТЕНТИФИКАЦИЯ
# ===========================================

# Секретный ключ для JWT (ОБЯЗАТЕЛЬНО ИЗМЕНИТЕ! Минимум 32 символа)
JWT_SECRET=your_super_secret_jwt_key_here_must_be_at_least_32_characters_long

# Время жизни JWT токена
JWT_EXPIRES_IN=24h

# Время жизни refresh токена
JWT_REFRESH_EXPIRES_IN=168h

# Издатель токена
JWT_ISSUER=axenta-crm

# ===========================================
# AXENTA CLOUD API
# ===========================================

# URL Axenta Cloud API
AXENTA_API_URL=https://axenta.cloud/api

# Таймаут для запросов к Axenta Cloud
AXENTA_TIMEOUT=30s

# Retry попытки для API запросов
AXENTA_MAX_RETRIES=3

# Интервал синхронизации данных из Axenta Cloud (в минутах)
# По умолчанию: 5 минут
# Рекомендуемые значения: 5-15 минут для продакшена
AXENTA_SYNC_INTERVAL=5

# ===========================================
# ЛОГИРОВАНИЕ
# ===========================================

# Уровень логирования (debug, info, warn, error, fatal, panic)
LOG_LEVEL=info

# Формат логов (json, text)
LOG_FORMAT=json

# Файл для записи логов (оставьте пустым для stdout)
LOG_FILE=

# Максимальный размер лог файла в МБ
LOG_MAX_SIZE=100

# Максимальное количество лог файлов
LOG_MAX_BACKUPS=10

# Максимальный возраст лог файлов в днях
LOG_MAX_AGE=30

# ===========================================
# CORS НАСТРОЙКИ
# ===========================================

# Разрешенные источники (домены)
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,https://app.yourdomain.com

# Разрешенные HTTP методы
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS

# Разрешенные заголовки
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With,Accept,Origin,X-Tenant-ID,x-tenant-id

# Разрешить учетные данные
CORS_ALLOW_CREDENTIALS=true

# Максимальный возраст preflight запроса
CORS_MAX_AGE=86400

# ===========================================
# БЕЗОПАСНОСТЬ И ОГРАНИЧЕНИЯ
# ===========================================

# Лимит запросов в минуту на IP
RATE_LIMIT_REQUESTS=100

# Временное окно для rate limiting
RATE_LIMIT_WINDOW=1m

# Максимальный размер запроса
MAX_REQUEST_SIZE=10MB

# Таймаут чтения запроса
REQUEST_TIMEOUT=30s

# Таймаут записи ответа
RESPONSE_TIMEOUT=30s

# Максимальное количество одновременных подключений
MAX_CONNECTIONS=1000

# ===========================================
# МОНИТОРИНГ И ДИАГНОСТИКА
# ===========================================

# Путь для health check
HEALTH_CHECK_PATH=/health

# Путь для метрик Prometheus
METRICS_PATH=/metrics

# Интервал обновления метрик
METRICS_INTERVAL=10s

# Включить profiling endpoints
ENABLE_PPROF=false

# Путь для pprof endpoints
PPROF_PATH=/debug/pprof

# ===========================================
# REDIS (ОПЦИОНАЛЬНО)
# ===========================================

# URL для подключения к Redis
REDIS_URL=redis://localhost:6379/0

# Пароль для Redis
REDIS_PASSWORD=

# Максимальное количество соединений в пуле
REDIS_MAX_CONNECTIONS=10

# Таймаут соединения с Redis
REDIS_TIMEOUT=5s

# ===========================================
# EMAIL НАСТРОЙКИ (ОПЦИОНАЛЬНО)
# ===========================================

# SMTP сервер
SMTP_HOST=smtp.gmail.com

# SMTP порт
SMTP_PORT=587

# SMTP пользователь
SMTP_USER=your_email@gmail.com

# SMTP пароль или app password
SMTP_PASSWORD=your_app_password

# Отправитель по умолчанию
SMTP_FROM=noreply@yourdomain.com

# Использовать TLS
SMTP_TLS=true

# ===========================================
# ФАЙЛОВОЕ ХРАНИЛИЩЕ
# ===========================================

# Тип хранилища (local, s3, gcs)
STORAGE_TYPE=local

# Директория для локального хранения
STORAGE_LOCAL_PATH=/opt/axenta/uploads

# Максимальный размер загружаемого файла
STORAGE_MAX_FILE_SIZE=50MB

# Разрешенные типы файлов
STORAGE_ALLOWED_TYPES=jpg,jpeg,png,gif,pdf,doc,docx,xls,xlsx

# ===========================================
# AWS S3 НАСТРОЙКИ (ЕСЛИ ИСПОЛЬЗУЕТСЯ)
# ===========================================

# AWS регион
AWS_REGION=us-east-1

# S3 bucket
S3_BUCKET=axenta-files

# AWS Access Key ID
AWS_ACCESS_KEY_ID=your_access_key

# AWS Secret Access Key
AWS_SECRET_ACCESS_KEY=your_secret_key

# ===========================================
# ДОПОЛНИТЕЛЬНЫЕ НАСТРОЙКИ
# ===========================================

# Часовой пояс
TIMEZONE=UTC

# Язык по умолчанию
DEFAULT_LANGUAGE=ru

# Включить режим отладки
DEBUG_MODE=false

# Включить hot reload в development режиме
HOT_RELOAD=false

# Директория для временных файлов
TEMP_DIR=/tmp/axenta

# ===========================================
# ВНЕШНИЕ СЕРВИСЫ
# ===========================================

# URL сервиса уведомлений
NOTIFICATION_SERVICE_URL=

# API ключ для сервиса уведомлений
NOTIFICATION_API_KEY=

# URL сервиса геокодирования
GEOCODING_SERVICE_URL=https://maps.googleapis.com/maps/api/geocode/json

# API ключ для Google Maps
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ===========================================
# ПРОИЗВОДИТЕЛЬНОСТЬ
# ===========================================

# Размер пула воркеров для фоновых задач
WORKER_POOL_SIZE=10

# Максимальное количество задач в очереди
MAX_QUEUE_SIZE=1000

# Таймаут выполнения фоновых задач
WORKER_TIMEOUT=60s

# Интервал очистки кэша
CACHE_CLEANUP_INTERVAL=300s

# ===========================================
# ИНТЕГРАЦИИ
# ===========================================

# Webhook URL для уведомлений
WEBHOOK_URL=

# Секрет для проверки webhook подписи
WEBHOOK_SECRET=

# Telegram Bot Token (для уведомлений)
TELEGRAM_BOT_TOKEN=

# Telegram Chat ID для уведомлений
TELEGRAM_CHAT_ID=

# Slack Webhook URL
SLACK_WEBHOOK_URL=

# ===========================================
# ПЛАНИРОВЩИК СНИМКОВ
# ===========================================

# Включить автоматический планировщик создания снимков
# Установите в true для включения автоматического создания ежедневных снимков
# По умолчанию: false (отключен в production)
ENABLE_SNAPSHOT_SCHEDULER=false

# Системный токен для доступа к Axenta Cloud API (для создания снимков)
# Этот токен используется для загрузки всех аккаунтов и объектов
# ОБЯЗАТЕЛЬНО установите этот токен для работы планировщика снимков!
AXENTA_ADMIN_TOKEN=your_axenta_admin_token_here

# ===========================================
# РЕЗЕРВНОЕ КОПИРОВАНИЕ
# ===========================================

# Включить автоматическое резервное копирование
BACKUP_ENABLED=true

# Интервал резервного копирования (в часах)
BACKUP_INTERVAL=24

# Количество хранимых копий
BACKUP_RETENTION=30

# Путь для сохранения резервных копий
BACKUP_PATH=/opt/axenta/backups

# ===========================================
# SECURITY HEADERS
# ===========================================

# Включить строгий транспортный протокол
HSTS_ENABLED=true

# Максимальный возраст HSTS
HSTS_MAX_AGE=31536000

# Включить Content Security Policy
CSP_ENABLED=true

# Политика CSP
CSP_POLICY=default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'
