# Пример файла конфигурации для скрипта авторизации Axenta API
# Скопируйте этот файл в .env и заполните реальными данными

# Учетные данные для авторизации
AXENTA_USERNAME=user@example.com
AXENTA_PASSWORD=password123

# Базовый URL API (по умолчанию: https://axenta.cloud/api)
AXENTA_BASE_URL=https://axenta.cloud/api

# Настройки запросов
AXENTA_TIMEOUT=10000
AXENTA_PER_PAGE=50

# Режим отладки (true/false)
DEBUG_MODE=false
