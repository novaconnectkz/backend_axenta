# Конфигурация базы данных PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=axenta_db
DB_SSLMODE=disable

# Порт сервера
SERVER_PORT=8080

# URL бэкенда (для CORS и других нужд)
# В разработке: http://localhost:8080
# В продакшене: http://194.87.143.169:8080
BACKEND_URL=http://localhost:8080

# Конфигурация Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Интеграция с Axetna.cloud
AXETNA_API_URL=https://api.axetna.cloud
ENCRYPTION_KEY=your-32-character-encryption-key!!

# Настройки синхронизации Axenta Cloud
# Интервал синхронизации данных из Axenta Cloud (в минутах)
# По умолчанию: 5 минут
AXENTA_SYNC_INTERVAL=5

# JWT секретный ключ
JWT_SECRET=your-jwt-secret-key-here

# DaData API ключ для поиска организаций по ИНН/ОГРН
DADATA_API_KEY=your_dadata_api_key_here

# Включить автоматический планировщик создания снимков
# По умолчанию: false (отключен в production, включен в development)
# Установите в true для включения автоматического создания ежедневных снимков
ENABLE_SNAPSHOT_SCHEDULER=false

# Системный токен для доступа к Axenta Cloud API (для создания снимков)
# Этот токен используется для загрузки всех аккаунтов и объектов
AXENTA_ADMIN_TOKEN=your_axenta_admin_token_here
